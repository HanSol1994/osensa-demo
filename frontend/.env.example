# Copy to .env.local (gitignored) and fill in. Vite only exposes VITE_-prefixed vars.
#
# WARNING: every value here is compiled into the PUBLIC JavaScript bundle. None of
# it is secret — anyone who loads the page can read the broker password. Security
# comes from the broker ACL restricting this identity to publishing orders and
# reading state, never from hiding these strings. See docs/SECURITY.md §1.
#
# Because of that, use a DEDICATED low-privilege broker credential here, never the
# one the kitchen uses.

# Which transport to build. Only "mqtt" exists today.
VITE_MESSAGING_BACKEND=mqtt

# --- Local development (bundled amqtt dev broker, no TLS, no auth) ------------
VITE_MQTT_URL=ws://localhost:9001/mqtt

# --- Hosted broker (HiveMQ Cloud) --------------------------------------------
# Port 8884 is HiveMQ's WebSocket-over-TLS listener; 8883 is plain MQTT over TLS
# and is not reachable from a browser. The /mqtt path is required.
#
# VITE_MQTT_URL=wss://<your-cluster-id>.s1.eu.hivemq.cloud:8884/mqtt
# VITE_MQTT_USERNAME=web-client
# VITE_MQTT_PASSWORD=<set in .env.local, and as a GitHub Actions secret - not here>
