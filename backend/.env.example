# Copy to .env (gitignored) and fill in. All settings take a RESTAURANT_ prefix.

# --- Local development (bundled amqtt dev broker) -----------------------------
RESTAURANT_BROKER_HOST=localhost
RESTAURANT_BROKER_PORT=9001
RESTAURANT_BROKER_TRANSPORT=websockets
RESTAURANT_BROKER_WS_PATH=/mqtt
RESTAURANT_BROKER_USE_TLS=false

# --- Hosted broker (HiveMQ Cloud) --------------------------------------------
# WebSockets over TLS on 8884, matching the browser, so both halves of the system
# genuinely speak MQTT over WebSockets as the assignment requires. Port 8883 (plain
# MQTT over TLS) would also work for this process but not for the browser, so using
# it here would make the two sides inconsistent for no gain.
#
# RESTAURANT_BROKER_HOST=<your-cluster-id>.s1.eu.hivemq.cloud
# RESTAURANT_BROKER_PORT=8884
# RESTAURANT_BROKER_TRANSPORT=websockets
# RESTAURANT_BROKER_WS_PATH=/mqtt
# RESTAURANT_BROKER_USE_TLS=true
# RESTAURANT_BROKER_USERNAME=kitchen
# RESTAURANT_BROKER_PASSWORD=<set as a Fly.io secret, never committed>

# --- Restaurant ---------------------------------------------------------------
RESTAURANT_TABLE_COUNT=4
RESTAURANT_COOK_MIN_SECONDS=10
RESTAURANT_COOK_MAX_SECONDS=30

# --- Demo / operations --------------------------------------------------------
# Full state snapshot logged on every transition. Handy for a walkthrough, noisy
# at scale.
RESTAURANT_LOG_STATE_SNAPSHOTS=true
# Honour the destructive reset command. Turn OFF for anything public-facing.
RESTAURANT_ENABLE_RESET=true
RESTAURANT_LOG_LEVEL=INFO
RESTAURANT_LOG_FORMAT=json
